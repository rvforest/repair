{
  "name": "repair",
  "version": "0.1.0",
  "description": "LLM-driven CLI tool for explaining terminal errors and suggesting direct fixes or debug steps",
  "main": "dist/index.js",
  "bin": {
    "repair": "./dist/cli.js"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "test": "vitest",
    "test:ci": "vitest run",
    "lint": "eslint src --ext .ts --max-warnings 0",
    "format": "prettier --write 'src/**/*.ts'"
  },
  "keywords": [
    "cli",
    "error",
    "debugging",
    "llm",
    "terminal",
    "shell",
    "shell-hooks"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "chalk": "^6.0.1",
    "commander": "^15.1.0",
    "node-fetch": "^3.3.2"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/node-fetch": "^2.6.9",
    "@typescript-eslint/eslint-plugin": "^8.72.2",
    "@typescript-eslint/parser": "^8.72.2",
    "eslint": "^10.15.0",
    "prettier": "^3.10.1",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  },
  "engines": {
    "node": ">=22.0.0"
  }
}
